    {
      "name": "Auth / Users",
      "item": [
        {
          "name": "1. Signup - Candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('candidate_token', json.data.token);",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}",
                  "if (json.data && json.data.user) pm.collectionVariables.set('user_id', json.data.user.user_id);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Candidate User\",\n  \"email\": \"candidate@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"candidate\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/users/signup", "host": ["{{base_url}}"], "path": ["api", "users", "signup"] }
          }
        },
